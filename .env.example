# claw2 environment: secrets only — everything else lives in .claw2/claw2.yaml.
# Окружение claw2: только секреты — всё остальное в .claw2/claw2.yaml.

# Model provider key, referenced from the config as env:OPENAI_API_KEY.
# Ключ провайдера модели; в конфиге ссылается как env:OPENAI_API_KEY.
OPENAI_API_KEY=

# Gateway / API key — required by the example config.
# Generate one: openssl rand -hex 24
# Ключ шлюза / API — нужен в примере конфига. Сгенерируйте: openssl rand -hex 24
CLAW2_GATEWAY_API_KEY=

# Time zone: reminders, schedules, date-and-time awareness.
# Set to your local zone (e.g. Europe/Berlin, Asia/Almaty).
# Часовой пояс: напоминания, расписания, ориентация в дате и времени.
# Укажите свой пояс (например Europe/Moscow, Asia/Almaty).
TZ=UTC
