# Example config with Gateway and optional memory (stage 2)
# Run: CLAW2_CONFIG_PATH=.claw2/claw2.gateway.yaml.example npm run gateway

llm:
  provider: openai
  model: gpt-4o-mini
  apiKey: env:OPENAI_API_KEY

memory:
  enabled: false
  embeddingModel: text-embedding-3-small
  maxChunks: 500
  maxRecallChunks: 5

gateway:
  port: 3000
  # Chats: local SQLite, persisted in the mounted data/ volume (compose).
  chatsDbPath: ./data/claw2_chats.sqlite
  # Postgres (databaseUrl) is only needed for hosted multi-user + registration.
  # API key auth is on by default — generate a key (openssl rand -hex 24) and
  # put it into .env as CLAW2_GATEWAY_API_KEY. The web UI and the API both ask
  # for it. Turn off only if the gateway is unreachable from other machines.
  auth:
    enabled: true
    apiKey: env:CLAW2_GATEWAY_API_KEY
    # Individual client: do not set registrationEnabled / databaseUrl / sessionSecret.
# Camera recognition (biometric identification). The recognition service
# signs its verdict; the browser only relays it. The gateway trusts a
# recognizedUser only with a valid fresh signature:
#   HMAC-SHA256(`${userId}:${ts}`, VISION_SECRET) → recognizedTs, recognizedSig
# Without recognizeSecret — or with a bad/stale signature — the claim is
# rejected outright (no memory binding, no superuser). Generate the secret:
#   openssl rand -hex 24   # → VISION_SECRET in .env
# vision:
#   enabled: true
#   superuserIds: []   # IDs with full access (including all users' memory)
#   recognizeUrl: http://localhost:9000/recognize   # POST frame → { userId, ts, sig }
#   recognizeSecret: env:VISION_SECRET

# Channels: Telegram and/or VK (private community, DMs to the bot)
# channels:
#   telegram:
#     enabled: true
#     botToken: env:TELEGRAM_BOT_TOKEN
#     # Channel messages are untrusted-origin content by default (they arm
#     # the prompt-injection provenance ledger). List the operator's own
#     # Telegram user IDs to treat those messages as trusted operator speech:
#     # trustedUserIds: [123456789]
#   vk:
#     enabled: true
#     accessToken: env:VK_ACCESS_TOKEN
#     groupId: 123456789   # community ID (positive number)
#     # Channel messages are untrusted-origin content by default (they arm
#     # the prompt-injection provenance ledger). List the operator's own IDs
#     # to treat those DMs as trusted operator speech:
#     # trustedUserIds: [12345678]
#     voice:               # same as Telegram: STT/TTS via voice service
#       sttUrl: http://localhost:8765/stt
#       ttsUrl: http://localhost:8765/tts
#       replyWithVoice: true
#       ttsMaxChars: 1000

# Scheduler: run agents on cron (see docs/scheduler-test.md)
# scheduler:
#   enabled: true

agentsDir: ./agents

# Activation cache (.claw-cache): export/import the context trajectory of a
# successful conversation and seed a new chat with it (cabinet → "Activation
# cache"). Keep it inside the mounted data/ volume (compose) so caches
# survive rebuilds. The directory may stay empty — the tab just lists files.
orchestrator:
  cacheStorePath: ./data/claw-cache
# Skill allowlist: only these files are executable by the agent. The model can
# draft a new skill, but running it needs your one-time confirmation — send
# `/allow <name>.js` in the chat and it lands in this list. Remove the section
# entirely to let the agent run anything in agents/ without confirmation.
skills:
  allowlist:
    - time.js
    - system-stats.js
    - fetch-json.js
    - download-file.js
    - surf.js
    - save-article.js
    - ya-search.js
    - weather.js
    - extract-pdf.js
    - docx.js
    - excel-reader.js
    - ocr.js
    - save-docx.js
    - rename-output.js
    - chart.js
sandbox:
  # Hard skill sandbox — on by default in this delivery (the compose stack
  # ships the restricted docker API proxy): every skill runs as a one-off
  # sibling container on an isolated docker network whose only way out is
  # the egress guard sidecar. Siblings use the claw2 image itself (skill
  # dependencies are preinstalled there).
  image: claw2:latest
  useDocker: true
  timeoutMs: 60000
  # Softening (at your own risk):
  #   useDocker: false    — run skills inside the gateway container instead
  #                         (no kernel isolation; the SSRF guard still covers
  #                         standard HTTP stacks, raw sockets become possible)
  #   egress.mode: "off"  — also drop the SSRF guard entirely (not recommended)
  # Outbound network control for skills (guard is the default):
  #   loopback, private, link-local and metadata destinations are blocked
  #   and audited; allowPrivateHosts lets skills reach your LAN services.
  egress:
    mode: guard
    allowPrivateHosts: false
  # Docker-sandbox resource caps per skill run.
  # dockerMemory: 512m
  # dockerPidsLimit: 64

# Prompt-injection containment ("lethal trifecta"): when a turn combines data
# access with untrusted content and a way to send it out, the turn is audited
# and stopped (block) or only logged with a warning (warn).
security:
  lethalTrifecta:
    enabled: true
    action: block
