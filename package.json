{
  "name": "claw2",
  "version": "0.2.16",
  "description": "Personal chat-driven AI agent",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "claw2": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-gateway-sql.cjs && node scripts/sync-wiki.mjs && esbuild src/sandbox/egress-preload.ts --bundle --platform=node --format=cjs --outfile=dist/egress-preload.cjs --log-level=warning && esbuild src/sandbox/egress-sidecar.ts --bundle --platform=node --format=cjs --outfile=dist/egress-sidecar.cjs --log-level=warning",
    "build:web": "cd web && npm run build",
    "build:pwa": "cd pwa && npm run build",
    "start": "node dist/cli.js",
    "chat": "npm run build && node dist/cli.js",
    "gateway": "node dist/gateway/cli.js",
    "dev": "npm run build && concurrently -n gw,web \"npm run dev:gateway\" \"npm run dev:web\"",
    "dev:only": "concurrently -n gw,web \"npm run dev:gateway\" \"npm run dev:web\"",
    "dev:gateway": "node dist/gateway/cli.js",
    "dev:web": "cd web && npm run dev",
    "dev:cli": "tsx src/cli.ts",
    "test": "node scripts/run-tests.cjs",
    "embed-daemon": "tsx src/memory/embed-daemon.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@huggingface/transformers": "^4.2.0",
    "@vexyl.ai/sip": "^1.0.4",
    "acme-client": "^5.4.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "chromadb": "^3.2.2",
    "dotenv": "^17.2.4",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mathjs": "^15.2.0",
    "openai": "^4.77.0",
    "pg": "^8.18.0",
    "sqlite-vec": "^0.1.9",
    "undici": "^7.2.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@huggingface/transformers": "$@huggingface/transformers"
  },
  "allowScripts": {
    "bcrypt": true,
    "better-sqlite3": true,
    "esbuild": true
  }
}
